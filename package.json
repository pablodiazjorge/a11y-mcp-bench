{
  "name": "a11y-mcp-bench",
  "version": "0.0.0",
  "private": true,
  "description": "A preregistered benchmark and an MCP server: does an accessibility MCP server help a coding agent fix WCAG defects in an Angular app, and at what cost?",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pablodiazjorge/a11y-mcp-bench.git"
  },
  "type": "module",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "packageManager": "npm@11.20.0",
  "workspaces": [
    "packages/*",
    "fixtures/*"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:lockfile-age": "node scripts/check-lockfile-age.ts",
    "ci": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage",
    "ci:full": "npm run ci"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
