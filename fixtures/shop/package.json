    "@angular/router": "22.3.0",
    "rxjs": "7.8.2",
    "tslib": "2.9.1"
  },
  "devDependencies": {
    "@angular/build": "22.3.0",
    "@angular/cli": "22.3.0",
    "@angular/compiler-cli": "22.3.0",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "angular-eslint": "22.8.0",
    "eslint": "10.14.0",
    "jsdom": "31.0.1",
    "typescript": "6.0.3",
